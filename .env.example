# Copy to .env for local development. Never commit a filled-in copy.

DATABASE_URL=postgres://app:app@127.0.0.1:5432/wafilter_dev
PORT=8080

# Signs subscriber sessions. Required in production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ISSUER=whatsapp-filter
SESSION_TOKEN_TTL_HOURS=336

# "dev" mints a session from an email alone, so the service refuses to boot with
# it when NODE_ENV=production. "external" verifies tokens from your IdP.
AUTH_MODE=dev

# AES-256-GCM key for the WhatsApp credentials in session_auth_state. 64 hex
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Required in production: without it, a database dump is a working login to
# every subscriber's WhatsApp. Rotating it logs everyone out — there is no
# re-wrap path, because keeping both keys live to avoid that is worse.
SESSION_ENCRYPTION_KEY=

# false serves the API alone and holds no WhatsApp sockets. Use it to split the
# web dyno from the worker; exactly one deployment should have this true.
RUN_WORKER=true

# How often the worker reconciles sockets and sweeps held actions.
WORKER_TICK_SECONDS=20

# We stop showing a pairing code at roughly the point WhatsApp stops accepting it.
PAIRING_CODE_TTL_SECONDS=180

# Activity rows older than this are swept nightly. Nothing else depends on them,
# so this is the whole retention story — there are no rollups underneath.
EVENT_RETENTION_DAYS=90
