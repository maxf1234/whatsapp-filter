{
  "name": "@whatsapp-filter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types --watch src/main.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "test:migrate": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://app:app@127.0.0.1:5432/wafilter_test} ../scripts/migrate.sh"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@whiskeysockets/baileys": "6.7.24",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
